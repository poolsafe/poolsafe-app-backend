# ==============================================================================
# PoolSafe API — Exemplo de Variáveis de Ambiente para Stack / Portainer (VPS)
# ==============================================================================
# Este arquivo contém apenas a definição estrutural e exemplos ilustrativos
# de variáveis para implantação da API em produção.
#
# NUNCA insira senhas, chaves privadas ou segredos reais neste arquivo.
# Os valores não são colocados no Git; são administrados diretamente no Portainer
# (seção "Environment variables" da Stack) e permanecem acessíveis aos administradores
# autorizados do Portainer e do Docker na VPS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. IMAGEM DOCKER (Opcional / Padrão Público)
# ------------------------------------------------------------------------------
# Referência da imagem pré-construída carregada localmente no Docker da VPS.
# Se omitida na Stack, utilizará o padrão: poolsafe-api:9a-20261009-e2da7dc
API_IMAGE=poolsafe-api:9a-20261009-e2da7dc

# ------------------------------------------------------------------------------
# 2. VARIÁVEIS SECRETAS OBRIGATÓRIAS NA STACK DE PRODUÇÃO (Cadastro no Portainer)
# ------------------------------------------------------------------------------
# A Stack de produção exige obrigatoriamente a definição destas variáveis.
# O deploy será bloqueado pelo Docker Compose se qualquer uma estiver ausente.
# Todos os valores abaixo são placeholders intencionalmente inválidos.

# [OBRIGATÓRIA] [SECRETA] URL de conexão com o MySQL na rede poolsafe-network.
# Host: mysql:3306 (container interno) | Banco: poolsafe
# A senha pode conter caracteres especiais e deve ser fornecida com URL encode (%40, etc.).
DATABASE_URL="mysql://<usuario_invalido>:<senha_url_encoded_invalida>@mysql:3306/poolsafe"

# [OBRIGATÓRIA] [SECRETA] Chave RSA privada (PKCS#8 PEM) em Base64 para assinatura RS256 de Access Tokens.
JWT_PRIVATE_KEY_BASE64="<chave_rsa_privada_pkcs8_pem_base64_invalida_substituir>"

# [OBRIGATÓRIA] [SENSÍVEL / PAR PÚBLICO] Chave RSA pública (SPKI PEM) em Base64 para verificação RS256.
JWT_PUBLIC_KEY_BASE64="<chave_rsa_publica_spki_pem_base64_invalida_substituir>"

# [OBRIGATÓRIA NA STACK] [SECRETA] Segredo criptográfico HMAC-SHA256 para assinatura do cursor opaco de alertas.
# Não possui valor funcional padrão na Stack de produção (deve ser chave forte e aleatória).
ALERT_CURSOR_SECRET="<segredo_hmac_sha256_invalido_substituir_por_chave_aleatoria_32_bytes>"

# [OBRIGATÓRIA NA STACK] [SECRETA] Chave da API do Resend para envio real de e-mails transacionais (redefinição de senha).
RESEND_API_KEY="<chave_api_resend_re_invalida_substituir_com_sending_access>"

# ------------------------------------------------------------------------------
# 3. CONFIGURAÇÕES OPERACIONAIS (Valores Padrão Públicos / Customizáveis)
# ------------------------------------------------------------------------------

# [OBRIGATÓRIA] Ambiente de execução da aplicação NestJS (production | development).
NODE_ENV=production

# [OPCIONAL] Porta interna e porta de bind no loopback da VPS (127.0.0.1:<PORT>:<PORT>).
PORT=3000

# [OPCIONAL] Emissor oficial dos tokens JWT (claim iss).
JWT_ISSUER=poolsafe-api

# [OPCIONAL] Rate limiting global: limite máximo de requisições por janela por IP.
THROTTLE_LIMIT=100

# [OPCIONAL] Rate limiting global: tamanho da janela temporal em segundos.
THROTTLE_TTL_SECONDS=60

# [OPCIONAL] Janela máxima sem heartbeat para considerar câmera como offline (em segundos).
CAMERA_OFFLINE_THRESHOLD_SECONDS=90

# [OPCIONAL] Tempo de validade do token de recuperação de senha em minutos.
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÃO DE E-MAILS TRANSACIONAIS (Valores Padrão Públicos / Customizáveis)
# ------------------------------------------------------------------------------

# [OPCIONAL] Nome e endereço do remetente exibido nos e-mails do sistema.
EMAIL_FROM="PoolSafe <nao-responda@send.poolsafe.app>"

# [OPCIONAL] URL pública da imagem do logotipo PoolSafe para renderização no template HTML.
EMAIL_LOGO_URL="https://poolsafe.app/assets/poolsafe-email-logo.png"
