{
  "name": "poolsafe-app-backend",
  "version": "0.1.0",
  "description": "API Node.js do PoolSafe",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 \"test/unit/**/*.test.ts\" \"test/integration/**/*.test.ts\"",
    "test:unit": "node --experimental-strip-types --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --experimental-strip-types --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "seed:home": "node --experimental-strip-types scripts/seed-home-dev.ts",
    "seed:cameras": "node --experimental-strip-types scripts/seed-cameras-dev.ts",
    "seed:alerts": "node --experimental-strip-types scripts/seed-alerts-dev.ts",
    "set:evidence": "node --experimental-strip-types scripts/set-evidence.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.4",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.32.0",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/uuid": "^10.0.0",
    "oxlint": "^1.58.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "typescript": "^6.0.2"
  }
}
