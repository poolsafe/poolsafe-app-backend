# Variáveis de ambiente da API PoolSafe
#
# Copie este arquivo para .env e preencha os valores no ambiente local.
# NUNCA commite o arquivo .env com valores reais.
# Segredos em produção devem ser fornecidos por variáveis de ambiente
# da plataforma de deploy (Portainer, Docker, etc.).

# Ambiente de execução: development | production
NODE_ENV=development

# Imagem Docker publicada no GHCR (utilizada no deploy / Portainer)
API_IMAGE=ghcr.io/poolsafe/poolsafe-app-backend:main

# Porta interna da API
PORT=3000

# Conexão com o banco de dados principal (MySQL 8.4 local via Docker Compose)
# Formato: mysql://usuario:senha@host:porta/banco
DATABASE_URL=mysql://poolsafe_dev:poolsafe_dev_password@127.0.0.1:3307/poolsafe

# Conexão com o banco de dados shadow (usado pelo Prisma Migrate em desenvolvimento)
SHADOW_DATABASE_URL=mysql://poolsafe_dev:poolsafe_dev_password@127.0.0.1:3307/poolsafe_shadow

# Variáveis do container MySQL local (Docker Compose)
MYSQL_PORT=3307
MYSQL_DATABASE=poolsafe
MYSQL_USER=poolsafe_dev
MYSQL_PASSWORD=poolsafe_dev_password
MYSQL_ROOT_PASSWORD=poolsafe_dev_root_secret

# Rate limiting global (por IP)
THROTTLE_LIMIT=100
THROTTLE_TTL_SECONDS=60

# Chaves RSA para JWT (RS256) em Base64
# Gerar par de chaves RSA (2048+ bits) em formato PEM e codificar em Base64.
# NUNCA versionar chaves reais.
JWT_PRIVATE_KEY_BASE64="<chave_rsa_privada_pkcs8_pem_em_base64>"
JWT_PUBLIC_KEY_BASE64="<chave_rsa_publica_spki_pem_em_base64>"
JWT_ISSUER="poolsafe-api"

# Janela de conectividade da câmera em segundos (padrão: 90)
CAMERA_OFFLINE_THRESHOLD_SECONDS=90

# Envio de E-mails Transacionais (Resend) - Fatia 3B
# NUNCA versionar a chave real do Resend.
RESEND_API_KEY="<resend_api_key_com_sending_access>"
EMAIL_FROM="PoolSafe <nao-responda@send.poolsafe.app>"
EMAIL_LOGO_URL="https://poolsafe.app/assets/poolsafe-email-logo.png"
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# Segredo criptográfico para assinatura HMAC-SHA256 do cursor de paginação de alertas (Fatia 7)
ALERT_CURSOR_SECRET="poolsafe-alerts-cursor-secret-local-dev"

