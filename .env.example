# Variáveis de ambiente da API PoolSafe
#
# Copie este arquivo para .env e preencha os valores no ambiente local.
# NUNCA commite o arquivo .env com valores reais.
# Segredos em produção devem ser fornecidos por variáveis de ambiente
# da plataforma de deploy (Portainer, Docker, etc.).

# Ambiente de execução: development | production
NODE_ENV=development

# Porta interna da API
PORT=3000

# Conexão com o banco de dados principal (MySQL 8.4 local via Docker Compose)
# Formato: mysql://usuario:senha@host:porta/banco
DATABASE_URL=mysql://poolsafe_dev:poolsafe_dev_password@127.0.0.1:3307/poolsafe

# Conexão com o banco de dados shadow (usado pelo Prisma Migrate em desenvolvimento)
SHADOW_DATABASE_URL=mysql://poolsafe_dev:poolsafe_dev_password@127.0.0.1:3307/poolsafe_shadow

# Variáveis do container MySQL local (Docker Compose)
MYSQL_PORT=3307
MYSQL_DATABASE=poolsafe
MYSQL_USER=poolsafe_dev
MYSQL_PASSWORD=poolsafe_dev_password
MYSQL_ROOT_PASSWORD=poolsafe_dev_root_secret

# Rate limiting global (por IP)
THROTTLE_LIMIT=100
THROTTLE_TTL_SECONDS=60
